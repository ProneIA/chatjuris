{
  "name": "Auditoria Semanal Autom\u00e1tica do Sistema",
  "description": "Executa automaticamente o protocolo de auditoria do sistema JURIS toda segunda-feira \u00e0s 7h, verificando integridade, seguran\u00e7a e conformidade LGPD.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 10 * * 1",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auditoria_semanal_autom_tica_do_sistema",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runSystemAudit",
            "args": {
              "trigger_type": "scheduled"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "runSystemAudit"
  }
}