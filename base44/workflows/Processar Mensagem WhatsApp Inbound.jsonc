{
  "name": "Processar Mensagem WhatsApp Inbound",
  "description": "Quando uma mensagem inbound chega no WhatsappMessage, chama o LLM e envia a resposta via Evolution API",
  "trigger": {
    "condition": "${ (.trigger.data.direction == \"inbound\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "WhatsappMessage"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "processar_mensagem_whatsapp_inbound",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processWhatsappInbound",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "processWhatsappInbound"
  }
}